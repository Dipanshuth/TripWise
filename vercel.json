{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*/",
      "destination": "https://tripwise-backend-xxlh.onrender.com/api/:path*/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://tripwise-backend-xxlh.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
