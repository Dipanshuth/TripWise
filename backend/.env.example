# Django Security & Core Settings
# In production on Render, generate a strong random secret key (min 50 chars)
SECRET_KEY=django-insecure-change-this-in-production-to-a-very-long-random-string

# Set to False in production on Render. Set to True for local development.
DEBUG=False

# Comma-separated list of allowed hostnames (e.g. your Render domain)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database Connection
# Leave unset or empty for local development (defaults to local SQLite: db.sqlite3)
# In production, provide the Neon PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=

# CORS & CSRF Settings
# Comma-separated list of origins permitted to make cross-origin requests
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tripwise.vercel.app

# Comma-separated list of trusted origins for CSRF validation (must include scheme)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tripwise.vercel.app

# Cookie Settings
# 'Lax' recommended if using same-origin Vercel rewrite proxy
# 'None' required if frontend and backend communicate directly across domains
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# SSL & Security (Optional overrides; Render handles SSL termination at proxy edge)
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# AI / External APIs
GEMINI_API_KEY=
